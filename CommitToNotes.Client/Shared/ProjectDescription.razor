<MudPaper Class="purple-container">
    <MudText Typo="Typo.h4" Class="simple-logo">Commit To Notes</MudText>
    <div class="description">
        <MudText Typo="Typo.h2">
            Notes that live where you work
        </MudText>
        <MudCard Class="description-card mt-3" style="background-color: #484286; color: #fbfbff; font-weight: 400">
            <MudCardContent >
                <p class="description-card-heading" > TOTAL NOTES CREATED TO DATE: </p>
                <p class="description-card-query" >SELECT COUNT(*) FROM Notes;</p>
                <p class="description-card-notes-number">123456789 </p>
            </MudCardContent>
        </MudCard>
    </div>
    <MudText Class="version" Typo="Typo.body1">Version 1.0.0. Status: in development for now </MudText>
</MudPaper>

